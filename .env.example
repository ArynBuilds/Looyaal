# Looyaal configuration
#
# Quick start:   node scripts/generate-secrets.mjs   (copies this file to .env
#                and fills every empty secret below), then: docker compose up -d --build
#
# [required] must be set   [optional] feature is disabled when empty
# NEXT_PUBLIC_* values are baked into the browser bundle at build time:
# rebuild the app (docker compose up -d --build app) after changing them.

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# [required] Where customers and staff open the app (your domain in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [required] Public URL of the Supabase API gateway (Kong), reachable from browsers.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# [optional] Cafe time zone (IANA). Send hours and quiet hours use the app's
# local clock; see docs/self-hosting.md before changing it.
TZ=Europe/Istanbul

# Host ports published by docker compose.
APP_PORT=3000
KONG_HTTP_PORT=8000

# ---------------------------------------------------------------------------
# Supabase (generated by scripts/generate-secrets.mjs)
# ---------------------------------------------------------------------------
# [required] Database password for all internal Supabase roles. Do not change
# after the first start (the database is initialised with it).
POSTGRES_PASSWORD=
# [required] JWT signing secret (min 32 chars). ANON/SERVICE keys are signed with it.
JWT_SECRET=
# [required] Public anon API key (JWT with role "anon").
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [required] Service role API key (JWT with role "service_role"). Server only, never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Access token lifetime in seconds.
JWT_EXPIRY=3600

# Only needed when running the app outside docker compose against a Supabase
# whose public URL is not reachable from the server (compose sets http://kong:8000).
# SUPABASE_SERVER_URL=

# ---------------------------------------------------------------------------
# Auth (GoTrue)
# ---------------------------------------------------------------------------
# Public sign-up stays off: the owner account is created once via the first-run
# setup screen and barista accounts by the owner, both through the admin API.
DISABLE_SIGNUP=true
# true = no confirmation email needed. Set false once SMTP below is configured.
ENABLE_EMAIL_AUTOCONFIRM=true
# Extra allowed redirect URLs after login (comma separated).
ADDITIONAL_REDIRECT_URLS=

# [optional] SMTP for confirmation / password-reset emails.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Looyaal

# ---------------------------------------------------------------------------
# App secrets (generated by scripts/generate-secrets.mjs)
# ---------------------------------------------------------------------------
# [required] Authenticates calls to /api/cron/* (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# [required] Signs customer QR tokens.
QR_TOKEN_SECRET=
# [required] Signs barista device setup links.
BARISTA_SETUP_SECRET=
# [required] Signs customer session cookies.
CUSTOMER_SESSION_SECRET=
# [required] Shared secret POS systems send to the POS webhook.
POS_WEBHOOK_SECRET=

# [required] Web Push (VAPID) key pair for customer notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# [optional] Contact for push services, e.g. mailto:you@yourcafe.com
# (defaults to mailto:owner@example.com).
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Built-in cron runner (UTC schedules in lib/scheduler/jobs.ts). Set to "off" if
# you prefer an external cron calling POST /api/cron/<job> with the CRON_SECRET.
LOOYAAL_SCHEDULER=on
# Base URL the scheduler calls (default http://127.0.0.1:$PORT).
# LOOYAAL_SCHEDULER_URL=

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# [optional] Weather-aware campaigns (openweathermap.org API key).
OPENWEATHERMAP_API_KEY=
# [optional] Instagram / influencer discovery (Meta app credentials).
META_APP_ID=
META_APP_SECRET=
# [optional] Google Business Profile review sync (Google OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Supabase Studio (optional: docker compose --profile studio up -d)
# Served at NEXT_PUBLIC_SUPABASE_URL behind HTTP basic auth.
# ---------------------------------------------------------------------------
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=

# [optional] Image transformations via imgproxy (also start --profile imgproxy).
ENABLE_IMAGE_TRANSFORMATION=false
